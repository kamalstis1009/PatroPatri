<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_layout"
    android:orientation="horizontal"
    android:layout_marginBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/item_image"
        app:civ_border_width="1dp"
        app:civ_border_color="@color/colorLightGrey"
        app:tint="@color/colorWhite"
        android:src="@drawable/ic_add_photo"
        android:layout_marginEnd="15dp"
        android:layout_width="70dp"
        android:layout_height="70dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/item_name"
            android:text="Product details of Buy 1 TVS Apache RTR 160 SD Racing Edition Glossy Motor Bike and Get 1 Samsung UA43T5400ARSFS 43 HD Smart TV - Black FREE"
            android:textSize="12sp"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/item_qty"
                android:text="৳ 159900 x 1"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/item_amount"
                android:layout_alignParentEnd="true"
                android:text="৳ 159900"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>