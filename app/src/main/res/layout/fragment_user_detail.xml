<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:orientation="vertical"
    android:background="@color/colorBackgroundGrey"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.fragments.UserDetailFragment">

    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--Cover Portion-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!--android:scaleType="fitXY"-->
                <ImageView
                    android:id="@+id/item_bg_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/background_image"
                    android:background="@color/colorBackgroundGrey"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"/>
                <RelativeLayout
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageButton
                        android:id="@+id/back_button"
                        android:src="@drawable/ic_baseline_arrow_back_24"
                        app:backgroundTint="@color/colorBackgroundGrey"
                        android:background="@drawable/shape_radius_100_pad_10_stroke_grey_bg_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageButton
                        android:id="@+id/item_share"
                        android:layout_alignParentEnd="true"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_baseline_more_vert_24"
                        app:backgroundTint="@android:color/transparent"
                        android:background="@drawable/shape_radius_100_pad_10_stroke_grey_bg_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </RelativeLayout>
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/item_image"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="-80dp"
                    android:layout_below="@+id/item_bg_image"
                    app:civ_border_width="1dp"
                    app:civ_border_color="@color/colorLightGrey"
                    app:civ_circle_background_color="@color/colorWhite"
                    app:tint="@color/colorWhite"
                    android:src="@drawable/ic_add_photo"
                    android:layout_width="150dp"
                    android:layout_height="150dp"/>
                <LinearLayout
                    android:layout_below="@+id/item_image"
                    android:gravity="center"
                    android:padding="15dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/item_title"
                        android:textSize="20sp"
                        android:text="Mohammad Ali"
                        android:textColor="@color/colorPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/item_address_designation"
                        android:text="Software Engineer | Chittagong"
                        android:textColor="@color/colorPurple"
                        android:layout_marginBottom="15dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                app:tint="@color/colorPrimary"
                                android:src="@drawable/ic_baseline_access_time_24"
                                android:layout_marginEnd="5dp"
                                android:layout_width="15dp"
                                android:layout_height="15dp"/>
                            <TextView
                                android:id="@+id/item_date"
                                android:textSize="10sp"
                                android:text="10th November"
                                android:textColor="@color/colorPrimary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:layout_marginEnd="10dp"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    app:tint="@color/colorPrimary"
                                    android:src="@drawable/ic_baseline_visibility_24"
                                    android:layout_marginEnd="5dp"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"/>
                                <TextView
                                    android:id="@+id/item_viewed"
                                    android:textSize="10sp"
                                    android:text="15K"
                                    android:textColor="@color/colorPrimary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    app:tint="@color/colorPrimary"
                                    android:src="@drawable/ic_baseline_favorite_24"
                                    android:layout_marginEnd="5dp"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"/>
                                <TextView
                                    android:id="@+id/item_liked"
                                    android:textSize="10sp"
                                    android:text="12K"
                                    android:textColor="@color/colorPrimary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>

            <!--Button Portion-->
            <LinearLayout
                android:weightSum="2"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <LinearLayout
                    android:id="@+id/item_about_button"
                    android:gravity="center"
                    android:layout_marginEnd="2dp"
                    android:background="@color/colorWhite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:text="About"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_photo_button"
                    android:gravity="center"
                    android:background="@color/colorWhite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:text="Photos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!--Body Portion-->
            <LinearLayout
                android:id="@+id/item_body"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>