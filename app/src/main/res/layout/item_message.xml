<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_marginBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/other_chat_layout"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="UselessParent">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/other_chat_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_baseline_person_24"
            app:civ_border_width="2dp"
            app:civ_border_color="@color/colorWhite"
            tools:ignore="VectorDrawableCompat" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_toEndOf="@+id/other_chat_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="UseCompoundDrawables">
            <TextView
                android:id="@+id/other_chat_text"
                android:layout_marginBottom="10dp"
                android:text="Attached Image"
                android:background="@drawable/shape_radius_100_pad_10_stroke_grey_bg_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/other_chat_attachment"
                android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                android:layout_width="150dp"
                android:layout_height="100dp" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/my_chat_layout"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="UselessParent">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/my_chat_image"
            android:layout_alignParentEnd="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_baseline_person_24"
            app:civ_border_width="2dp"
            app:civ_border_color="@color/colorWhite"
            tools:ignore="VectorDrawableCompat" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_toStartOf="@+id/my_chat_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="UseCompoundDrawables">
            <TextView
                android:id="@+id/my_chat_text"
                android:layout_marginBottom="10dp"
                android:textAlignment="textEnd"
                android:layout_gravity="end"
                android:text="Attached Image"
                android:background="@drawable/shape_radius_100_pad_10_stroke_grey_bg_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/my_chat_attachment"
                android:layout_gravity="end"
                android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                android:layout_width="150dp"
                android:layout_height="100dp" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>