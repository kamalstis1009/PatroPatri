<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/colorBackgroundGrey"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.fragments.PasswordFragment">

    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:padding="25dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_marginBottom="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/back_button"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ic_baseline_arrow_back_24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/title"
                    android:textSize="20sp"
                    android:text="Password"
                    android:layout_centerInParent="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>

            <com.google.android.material.textfield.TextInputLayout
                app:hintTextColor="@color/colorPrimary"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/previous_password"
                    android:inputType="text"
                    android:singleLine="true"
                    android:maxLength="25"
                    android:maxEms="25"
                    android:hint="Previous Password"
                    app:drawableTint="@color/colorDeepGrey"
                    android:drawableEnd="@drawable/ic_baseline_lock_open_24"
                    android:background="@drawable/shape_radius_100_edit_text"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="25dp"
                    android:paddingEnd="25dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:hintTextColor="@color/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/new_password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:maxLength="25"
                    android:maxEms="25"
                    android:hint="New Password"
                    app:drawableTint="@color/colorDeepGrey"
                    android:drawableEnd="@drawable/ic_baseline_lock_24"
                    android:background="@drawable/shape_radius_100_edit_text"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="25dp"
                    android:paddingEnd="25dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:hintTextColor="@color/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/confirm_password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:maxLength="25"
                    android:maxEms="25"
                    android:hint="Confirm Password"
                    app:drawableTint="@color/colorDeepGrey"
                    android:drawableEnd="@drawable/ic_baseline_lock_24"
                    android:background="@drawable/shape_radius_100_edit_text"
                    android:layout_marginBottom="25dp"
                    android:paddingStart="25dp"
                    android:paddingEnd="25dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/update_button"
                android:text="Update"
                android:padding="15dp"
                android:textColor="@color/colorWhite"
                app:backgroundTint="@color/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>