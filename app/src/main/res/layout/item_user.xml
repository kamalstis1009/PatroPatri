<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_layout"
    android:layout_marginBottom="15dp"
    android:background="@color/colorWhite"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--android:scaleType="fitXY"-->
    <ImageView
        android:id="@+id/item_bg_image"
        android:scaleType="centerCrop"
        android:src="@drawable/background_image"
        android:background="@color/colorBackgroundGrey"
        android:layout_width="match_parent"
        android:layout_height="150dp"/>

    <Button
        android:id="@+id/message_button"
        android:text="Message"
        android:textAllCaps="false"
        android:textColor="@color/colorWhite"
        app:cornerRadius="25dp"
        android:layout_margin="15dp"
        android:layout_alignParentEnd="true"
        app:backgroundTint="@color/colorAccent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_marginTop="-70dp"
        android:padding="15dp"
        android:layout_below="@+id/item_bg_image"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/item_image"
                app:civ_border_width="1dp"
                app:civ_border_color="@color/colorLightGrey"
                app:civ_circle_background_color="@color/colorWhite"
                app:tint="@color/colorWhite"
                android:src="@drawable/ic_add_photo"
                android:layout_marginEnd="15dp"
                android:layout_width="120dp"
                android:layout_height="120dp"/>
            <LinearLayout
                android:layout_marginTop="60dp"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/item_name"
                    android:textSize="20sp"
                    android:text="Candidate's Name"
                    android:textColor="@color/colorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/item_short_title"
                    android:text="Designation | District"
                    android:textColor="@color/colorPurple"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/item_description"
                android:ellipsize="end"
                android:maxLines="4"
                android:textSize="10sp"
                android:layout_marginBottom="5dp"
                android:text="Briefly describe yourself."
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:ellipsize="end"
                android:maxLines="4"
                android:textSize="10sp"
                android:text="Read More..."
                android:textColor="@color/colorPurple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    app:tint="@color/colorPrimary"
                    android:src="@drawable/ic_baseline_access_time_24"
                    android:layout_marginEnd="5dp"
                    android:layout_width="15dp"
                    android:layout_height="15dp"/>
                <TextView
                    android:id="@+id/item_date"
                    android:textSize="10sp"
                    android:text="10th November"
                    android:textColor="@color/colorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_marginEnd="10dp"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        app:tint="@color/colorPrimary"
                        android:src="@drawable/ic_baseline_visibility_24"
                        android:layout_marginEnd="5dp"
                        android:layout_width="15dp"
                        android:layout_height="15dp"/>
                    <TextView
                        android:id="@+id/item_viewed"
                        android:textSize="10sp"
                        android:text="15K"
                        android:textColor="@color/colorPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        app:tint="@color/colorPrimary"
                        android:src="@drawable/ic_baseline_favorite_24"
                        android:layout_marginEnd="5dp"
                        android:layout_width="15dp"
                        android:layout_height="15dp"/>
                    <TextView
                        android:id="@+id/item_liked"
                        android:textSize="10sp"
                        android:text="12K"
                        android:textColor="@color/colorPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>