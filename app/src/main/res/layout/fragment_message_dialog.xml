<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:background="@color/colorBackgroundGrey"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.dialogs.MessageFragmentDialog">

    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:padding="15dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Toolbar -->
            <RelativeLayout
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/back_button"
                    android:src="@drawable/ic_baseline_arrow_back_24"
                    android:backgroundTint="@color/colorWhite"
                    android:background="@drawable/shape_radius_100_pad_10_stroke_grey_bg_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerInParent="true"
                    android:text="Message"
                    android:textSize="20sp"
                    android:textAllCaps="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/item_address"
                    android:gravity="top"
                    android:maxLength="250"
                    android:maxEms="250"
                    android:inputType="text|textMultiLine"
                    android:textSize="12sp"
                    android:hint="Message"
                    app:drawableTint="@color/colorDeepGrey"
                    android:background="@drawable/shape_radius_25_edit_text"
                    android:paddingStart="25dp"
                    android:paddingEnd="25dp"
                    android:layout_width="match_parent"
                    android:layout_height="150dp" />
            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/submit_button"
                android:text="Send"
                android:textColor="@color/colorWhite"
                app:cornerRadius="25dp"
                android:padding="15dp"
                android:layout_marginTop="25dp"
                app:backgroundTint="@color/colorAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>