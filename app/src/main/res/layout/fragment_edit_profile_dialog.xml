<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:background="@color/colorBackgroundGrey"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.dialogs.EditProfileFragmentDialog">

    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:padding="15dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Toolbar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/back_button"
                    android:src="@drawable/ic_baseline_arrow_back_24"
                    app:backgroundTint="@color/colorWhite"
                    android:background="@drawable/shape_radius_100_pad_10_stroke_grey_bg_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_centerInParent="true"
                    android:text="Update"
                    android:textSize="15sp"
                    android:textAllCaps="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageButton
                    android:id="@+id/item_share"
                    android:layout_alignParentEnd="true"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ic_baseline_more_vert_24"
                    app:backgroundTint="@android:color/transparent"
                    android:background="@drawable/shape_radius_100_pad_10_stroke_grey_bg_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </RelativeLayout>

            <!-- Portion 1 -->
            <LinearLayout
                android:id="@+id/part_1"
                android:visibility="gone"
                android:orientation="vertical"
                android:layout_marginTop="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_summary"
                        android:gravity="top"
                        android:maxLength="1550"
                        android:maxEms="1550"
                        android:hint="Summary"
                        android:inputType="text|textMultiLine"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:layout_marginBottom="10dp"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Portion 2 -->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/part_2"
                android:orientation="vertical"
                android:layout_marginTop="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_full_name"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:hint="Full Name"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_person_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <Spinner
                    android:id="@+id/item_gender"
                    android:entries="@array/gender_array"
                    android:background="@drawable/layer_list_spinner_radius_8"
                    android:padding="20dp"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_birth"
                        android:inputType="date"
                        android:singleLine="true"
                        android:maxLength="25"
                        android:maxEms="25"
                        android:hint="Date of Birth"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_date_range_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:focusableInTouchMode="false"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_height"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLength="10"
                        android:maxEms="10"
                        android:hint="Height"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_height_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_weight"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLength="10"
                        android:maxEms="10"
                        android:hint="Weight"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_amp_stories_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <Spinner
                    android:id="@+id/item_marital_status"
                    android:entries="@array/marital_status_array"
                    android:background="@drawable/layer_list_spinner_radius_8"
                    android:padding="20dp"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <Spinner
                    android:id="@+id/item_religion"
                    android:entries="@array/religion_array"
                    android:background="@drawable/layer_list_spinner_radius_8"
                    android:padding="20dp"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <Spinner
                    android:id="@+id/item_complex"
                    android:entries="@array/complex_array"
                    android:background="@drawable/layer_list_spinner_radius_8"
                    android:padding="20dp"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <Spinner
                    android:id="@+id/item_district"
                    android:entries="@array/district_array"
                    android:background="@drawable/layer_list_spinner_radius_8"
                    android:padding="20dp"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Portion 3 -->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/part_3"
                android:orientation="vertical"
                android:layout_marginTop="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_service"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:hint="Service Name"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_person_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_designation"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:hint="Designation"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_credit_card_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_company"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:hint="Company Name"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_account_balance_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_company_address"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:hint="Address"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_location_on_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_company_website"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:hint="Website"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_web_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Portion 4 -->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/part_4"
                android:orientation="vertical"
                android:layout_marginTop="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_phone_number"
                        android:inputType="phone"
                        android:singleLine="true"
                        android:maxLength="25"
                        android:maxEms="25"
                        android:hint="Phone Number"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_call_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:layout_marginBottom="10dp"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_email"
                        android:inputType="textWebEmailAddress"
                        android:singleLine="true"
                        android:hint="Email"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:textSize="12sp"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_email_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:layout_marginBottom="10dp"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_present_address"
                        android:gravity="top"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:hint="Present Address"
                        android:inputType="text|textMultiLine"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_location_on_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:layout_marginBottom="10dp"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/item_permanent_address"
                        android:gravity="top"
                        android:maxLength="250"
                        android:maxEms="250"
                        android:hint="Permanent Address"
                        android:inputType="text|textMultiLine"
                        app:drawableTint="@color/colorDeepGrey"
                        android:drawableEnd="@drawable/ic_baseline_location_on_24"
                        android:background="@drawable/shape_radius_8_pad_10_stroke_grey_solid_white"
                        android:layout_marginBottom="10dp"
                        android:paddingStart="25dp"
                        android:paddingEnd="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <Button
                android:id="@+id/submit_button"
                android:text="Update"
                android:textColor="@color/colorWhite"
                android:padding="15dp"
                android:layout_marginTop="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>